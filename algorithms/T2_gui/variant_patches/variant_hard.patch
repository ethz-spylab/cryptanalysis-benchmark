+//////////////////////  GF(256^104)  (added for scaling-down variant; W=13)  /////////////////////////
+///    irreducible over GF(256):  x^13 + 0x09 x + 0x01
+
+static inline
+void gf256ext_13_xor( uint8_t * b , const uint8_t * a ) { gf256v_add( b , a , 13 ); }
+
+static inline
+void gf256ext_13_mul( uint8_t * c , const uint8_t * a , const uint8_t * b )
+{
+	static const unsigned W = 13;
+	uint8_t tmp_mul[26] = {0};
+	for(unsigned i=0;i<W;i++) gf256v_madd( tmp_mul+i , a , b[i] , W );
+	for(unsigned i=(W-1)*2;i>=W;i--) {
+		uint8_t hi = tmp_mul[i];
+		tmp_mul[i] = 0;
+		tmp_mul[i-W+1] ^= gf256_mul(0x09, hi);
+		tmp_mul[i-W+0] ^= hi;
+	}
+	for(unsigned i=0;i<W;i++) c[i] = tmp_mul[i];
+}
